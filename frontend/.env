VITE_PRIV_API_URL={{PRIV_API_URL}}
VITE_SITE_URL=https://giftmugweni.com
VITE_CMS_URL={{CMS_URL}}
# The CMS's own origin, for endpoints the Go backend does not proxy (the
# anonymous /public routes). VITE_CMS_URL points at the Go backend's /cms
# proxy, so it cannot be used for those.
VITE_CMS_API_URL={{CMS_API_URL}}
VITE_CMS_AUTH0_DOMAIN={{CMS_AUTH0_DOMAIN}}
VITE_CMS_AUTH0_CLIENT_ID={{CMS_AUTH0_CLIENT_ID}}
VITE_CMS_AUTH0_CLIENT_SECRET={{CMS_AUTH0_CLIENT_SECRET}}
VITE_CMS_AUTH0_AUDIENCE={{CMS_AUTH0_AUDIENCE}}
